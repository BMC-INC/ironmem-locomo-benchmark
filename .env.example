# Copy to .env and configure one backend. Never commit credentials.

# IronMem REST server; start it with `ironmem server`, not `ironmem serve`.
IRONMEM_URL=http://localhost:37778

# Default backend: Vertex AI Gemini with Application Default Credentials.
# GOOGLE_CLOUD_PROJECT must identify a project you are authorized to use.
BENCH_LLM=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Public OpenAI alternative: set BENCH_LLM=openai and supply an API key.
# OPENAI_API_KEY=
# OPENAI_ANSWERER_MODEL=gpt-4.1
# OPENAI_JUDGE_MODEL=gpt-4.1

# Azure OpenAI alternative: set BENCH_LLM=openai. Use deployment names for
# OPENAI_ANSWERER_MODEL and OPENAI_JUDGE_MODEL. Managed Identity is the default.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_USE_MI=1
